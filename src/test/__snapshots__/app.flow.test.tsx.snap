exports[`FIN-A app flow > renders every screen and the full quest flow identically > 01-welcome 1`] = `"<main class="app-stage"><section class="phone-shell" aria-label="FIN-A mobile app prototype"><div class="status-bar" aria-hidden="true"><span>9:41</span><span class="dynamic-island"></span><span class="status-icons">▮▮▮ ◒ ▰</span></div><div class="screen screen-welcome"><div class="onboarding-page welcome-page"><header class="welcome-logo"><img class="brand-mark  brand-mark-lockup" alt="FIN-A, Financial Assistant App" src="data:image/svg+xml;base64,"></header><section class="welcome-copy"><h1>Money that<br>follows your life</h1><p>Turn meals, rides, savings,<br>and transfers into rewards.</p></section><figure class="welcome-visual"><img alt="Friends walking through a sunny Manila street beside a jeepney and neighborhood store" src="asset:welcome-manila.webp"><span class="welcome-visual-fade"></span></figure><div class="welcome-actions"><button class="primary-button welcome-primary" type="button"><span>✦</span> Start my journey <b>›</b></button><button class="secondary-button" type="button">I already have an account</button><div class="welcome-dots" aria-label="Welcome step 1 of 3"><span class="is-active"></span><span></span><span></span></div></div></div></div></section></main>"`;

exports[`FIN-A app flow > renders every screen and the full quest flow identically > 02-sign-in 1`] = `"<main class="app-stage"><section class="phone-shell" aria-label="FIN-A mobile app prototype"><div class="status-bar" aria-hidden="true"><span>9:41</span><span class="dynamic-island"></span><span class="status-icons">▮▮▮ ◒ ▰</span></div><div class="screen screen-sign-in"><div class="onboarding-page sign-in-page"><header class="centered-app-bar sign-in-header"><button class="icon-button" type="button" aria-label="Back to welcome"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg></button><img class="brand-mark brand-mark-compact " alt="FIN-A" src="data:image/svg+xml;base64,"><span class="app-bar-spacer"></span></header><section class="sign-in-copy"><p class="eyebrow">Welcome back</p><h1>Pick up where<br>you left off</h1><p>Your wallet, quests, and money style are waiting.</p></section><form class="auth-form"><label><span>Email address</span><span class="input-shell"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M4 7l8 6 8-6"></path></svg><input autocomplete="email" placeholder="maya@example.com" required="" type="email" value=""></span></label><label><span>Password</span><span class="input-shell"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 018 0v3M12 14v3"></path></svg><input autocomplete="current-password" placeholder="Enter your password" required="" type="password" value=""><button type="button" aria-label="Show password"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button></span></label><button class="forgot-button" type="button">Forgot password?</button><button class="primary-button" type="submit">Sign in</button></form><div class="demo-auth"><span>Frontend prototype</span><p>No real account or credentials are required.</p><button class="secondary-button" type="button">Continue with demo account</button></div></div></div></section></main>"`;

exports[`FIN-A app flow > renders every screen and the full quest flow identically > 03-quiz 1`] = `"<main class="app-stage"><section class="phone-shell" aria-label="FIN-A mobile app prototype"><div class="status-bar" aria-hidden="true"><span>9:41</span><span class="dynamic-island"></span><span class="status-icons">▮▮▮ ◒ ▰</span></div><div class="screen screen-quiz"><div class="onboarding-page quiz-page"><header class="centered-app-bar"><button class="icon-button" type="button" aria-label="Go back"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg></button><img class="brand-mark brand-mark-compact " alt="FIN-A" src="data:image/svg+xml;base64,"><span class="app-bar-spacer"></span></header><section class="quiz-intro"><h1>Find your money style</h1><div class="progress-heading"><strong>3 of 5</strong></div><div class="progress-track" aria-label="Question 3 of 5"><span style="width: 60%;"></span></div></section><div class="orbit-accent" aria-hidden="true"><span>✦</span></div><fieldset class="answer-list"><legend>When you want something, what usually happens?</legend><button class="answer-option is-selected" type="button" aria-pressed="true"><span class="answer-icon"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 012-2h14a2 2 0 012 2v12H5a2 2 0 01-2-2V7z"></path><path d="M3 8h16a2 2 0 012 2v3h-6a2 2 0 010-4h6"></path></svg></span><span>I get it while the feeling is fresh</span><span class="answer-check"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4 4L19 7"></path></svg></span></button><button class="answer-option " type="button" aria-pressed="false"><span class="answer-icon"><svg viewBox="0 0 24 24" aria-hidden=